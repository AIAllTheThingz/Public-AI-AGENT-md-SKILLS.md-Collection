{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AIAllTheThingz/Public-AI-Governance/main/schemas/v2/completion-result.schema.json",
  "title": "Completion Result",
  "description": "Records implementation state, validation outcomes, limitations, risk, compatibility impact, review, and execution discipline without treating a single successful command as proof of full completion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "filesChanged",
    "validation",
    "limitations",
    "schemaVersion",
    "executionDiscipline"
  ],
  "properties": {
    "status": {
      "enum": [
        "implemented",
        "validated",
        "partially-validated",
        "not-completed"
      ],
      "description": "Overall completion state."
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "filesChanged": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "risk": {
      "enum": [
        "low",
        "moderate",
        "high",
        "critical"
      ]
    },
    "securityImpact": {
      "type": "string",
      "minLength": 1
    },
    "compatibilityImpact": {
      "type": "string",
      "minLength": 1
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "result"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "passed",
              "failed",
              "not-run"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "environment": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time"
    },
    "artifact": {
      "type": "string",
      "minLength": 1,
      "description": "Commit, tag, digest, or artifact identifier to which the result applies."
    },
    "schemaVersion": {
      "type": "string",
      "const": "2.0.0",
      "description": "Required explicit instance contract version."
    },
    "executionDiscipline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failedOrIndeterminateOutcomes",
        "authorizationRecoveryContinuity",
        "retryLedger",
        "resetBasis",
        "progressOrBlockerNarrowing",
        "delegationHandoff",
        "outOfScopeRouting"
      ],
      "properties": {
        "failedOrIndeterminateOutcomes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "authorizationRecoveryContinuity": {
          "type": "string",
          "minLength": 1
        },
        "retryLedger": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "patternProperties": {
            "^.+$": {
              "$ref": "#/$defs/objectiveRetryLedger"
            }
          },
          "additionalProperties": false
        },
        "resetBasis": {
          "type": "string",
          "minLength": 1,
          "description": "Not applicable is permitted when no reset occurred."
        },
        "progressOrBlockerNarrowing": {
          "type": "string",
          "minLength": 1
        },
        "delegationHandoff": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "boundariesPreserved"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "boundariesPreserved": {
              "type": "boolean"
            }
          }
        },
        "outOfScopeRouting": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced extension data. Extension keys must be organization- or product-specific and must not redefine standard fields.",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{1,127}$"
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "ledgerAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "actor",
        "executionContext",
        "startedAt",
        "endedAt",
        "effectsReconciliation",
        "result",
        "budgetPosition",
        "justification",
        "terminalDisposition"
      ],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "executionContext": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "commandSequence": {
              "type": "string",
              "minLength": 1
            },
            "plan": {
              "type": "string",
              "minLength": 1
            },
            "workflow": {
              "type": "string",
              "minLength": 1
            },
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "agent": {
              "type": "string",
              "minLength": 1
            },
            "strategy": {
              "type": "string",
              "minLength": 1
            },
            "task": {
              "type": "string",
              "minLength": 1
            },
            "session": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "endedAt": {
          "type": "string",
          "format": "date-time"
        },
        "effectsReconciliation": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "Successful",
            "Failed",
            "Indeterminate"
          ],
          "description": "Failed or Indeterminate execution, including read-only execution for the same objective or blocker, consumes retry budget. Successful evidence-only discovery, reconciliation, and validation may be non-consuming."
        },
        "budgetPosition": {
          "enum": [
            "initial-attempt",
            "retry-1",
            "retry-2",
            "non-consuming"
          ]
        },
        "justification": {
          "type": "string",
          "minLength": 1
        },
        "terminalDisposition": {
          "enum": [
            "objective-completed",
            "retry-authorized",
            "reported-unresolved",
            "not-terminal"
          ]
        }
      }
    },
    "budgetedAttempt": {
      "allOf": [
        {
          "$ref": "#/$defs/ledgerAction"
        },
        {
          "if": {
            "properties": {
              "result": {
                "const": "Successful"
              }
            },
            "required": [
              "result"
            ]
          },
          "then": {
            "properties": {
              "terminalDisposition": {
                "const": "objective-completed"
              }
            }
          },
          "else": {
            "properties": {
              "terminalDisposition": {
                "enum": [
                  "retry-authorized",
                  "reported-unresolved"
                ]
              }
            }
          }
        }
      ]
    },
    "objectiveRetryLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempts",
        "nonConsumingActions"
      ],
      "properties": {
        "attempts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "initialAttempt": {
              "allOf": [
                {
                  "$ref": "#/$defs/budgetedAttempt"
                },
                {
                  "properties": {
                    "budgetPosition": {
                      "const": "initial-attempt"
                    }
                  }
                }
              ]
            },
            "retry1": {
              "allOf": [
                {
                  "$ref": "#/$defs/budgetedAttempt"
                },
                {
                  "properties": {
                    "budgetPosition": {
                      "const": "retry-1"
                    }
                  }
                }
              ]
            },
            "retry2": {
              "allOf": [
                {
                  "$ref": "#/$defs/budgetedAttempt"
                },
                {
                  "properties": {
                    "budgetPosition": {
                      "const": "retry-2"
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "result": {
                        "enum": [
                          "Failed",
                          "Indeterminate"
                        ]
                      }
                    },
                    "required": [
                      "result"
                    ]
                  },
                  "then": {
                    "properties": {
                      "terminalDisposition": {
                        "const": "reported-unresolved"
                      }
                    }
                  }
                }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "retry1"
                ]
              },
              "then": {
                "required": [
                  "initialAttempt"
                ],
                "properties": {
                  "initialAttempt": {
                    "properties": {
                      "result": {
                        "enum": [
                          "Failed",
                          "Indeterminate"
                        ]
                      }
                    },
                    "required": [
                      "result"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "required": [
                  "retry2"
                ]
              },
              "then": {
                "required": [
                  "initialAttempt",
                  "retry1"
                ],
                "properties": {
                  "retry1": {
                    "properties": {
                      "result": {
                        "enum": [
                          "Failed",
                          "Indeterminate"
                        ]
                      }
                    },
                    "required": [
                      "result"
                    ]
                  }
                }
              }
            }
          ]
        },
        "nonConsumingActions": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/ledgerAction"
              },
              {
                "properties": {
                  "budgetPosition": {
                    "const": "non-consuming"
                  },
                  "result": {
                    "const": "Successful"
                  },
                  "terminalDisposition": {
                    "const": "not-terminal"
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "x-schemaVersion": "2.0.0"
}
