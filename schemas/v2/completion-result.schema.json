{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AIAllTheThingz/Public-AI-Governance/main/schemas/v2/completion-result.schema.json",
  "title": "Completion Result",
  "description": "Records implementation state, validation outcomes, limitations, risk, compatibility impact, review, and execution discipline without treating a single successful command as proof of full completion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "filesChanged",
    "validation",
    "limitations",
    "schemaVersion",
    "executionDiscipline"
  ],
  "properties": {
    "status": {
      "enum": [
        "implemented",
        "validated",
        "partially-validated",
        "not-completed"
      ],
      "description": "Overall completion state."
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "filesChanged": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "risk": {
      "enum": [
        "low",
        "moderate",
        "high",
        "critical"
      ]
    },
    "securityImpact": {
      "type": "string",
      "minLength": 1
    },
    "compatibilityImpact": {
      "type": "string",
      "minLength": 1
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "result"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "passed",
              "failed",
              "not-run"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "environment": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time"
    },
    "artifact": {
      "type": "string",
      "minLength": 1,
      "description": "Commit, tag, digest, or artifact identifier to which the result applies."
    },
    "schemaVersion": {
      "type": "string",
      "const": "2.0.0",
      "description": "Required explicit instance contract version."
    },
    "executionDiscipline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failedOrIndeterminateOutcomes",
        "authorizationRecoveryContinuity",
        "retryLedger",
        "resetBasis",
        "progressOrBlockerNarrowing",
        "delegationHandoff",
        "outOfScopeRouting"
      ],
      "properties": {
        "failedOrIndeterminateOutcomes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "authorizationRecoveryContinuity": {
          "type": "string",
          "minLength": 1
        },
        "retryLedger": {
          "type": "object",
          "description": "Per-objective retry evidence. A non-empty failedOrIndeterminateOutcomes array requires at least one objective ledger, and every supplied objective ledger must contain a Failed or Indeterminate attempt. When that outcomes array is empty, no supplied objective ledger may contain a Failed or Indeterminate attempt.",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "patternProperties": {
            "^.+$": {
              "$ref": "#/$defs/objectiveRetryLedger"
            }
          },
          "additionalProperties": false
        },
        "resetBasis": {
          "type": "string",
          "minLength": 1,
          "description": "Summary of any retry-budget reset. Each sequence after the first records its own prior stop/report, authorization, and material-change evidence. Not applicable is permitted when no reset occurred."
        },
        "progressOrBlockerNarrowing": {
          "type": "string",
          "minLength": 1
        },
        "delegationHandoff": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "boundariesPreserved"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "boundariesPreserved": {
              "const": true,
              "description": "Delegation must preserve retry-budget, no-progress, scope, authorization, and evidence boundaries."
            }
          }
        },
        "outOfScopeRouting": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "failedOrIndeterminateOutcomes": {
                "minItems": 1
              }
            },
            "required": [
              "failedOrIndeterminateOutcomes"
            ]
          },
          "then": {
            "properties": {
              "retryLedger": {
                "minProperties": 1,
                "patternProperties": {
                  "^.+$": {
                    "$ref": "#/$defs/objectiveRetryLedgerWithFailure"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "retryLedger": {
                "patternProperties": {
                  "^.+$": {
                    "not": {
                      "$ref": "#/$defs/objectiveRetryLedgerWithFailure"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced extension data. Extension keys must be organization- or product-specific and must not redefine standard fields.",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{1,127}$"
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "validation": {
            "contains": {
              "properties": {
                "result": {
                  "const": "passed"
                }
              },
              "required": [
                "result"
              ]
            }
          }
        },
        "required": [
          "validation"
        ]
      },
      "then": {
        "properties": {
          "executionDiscipline": {
            "properties": {
              "retryLedger": {
                "minProperties": 1
              }
            },
            "required": [
              "retryLedger"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "ledgerAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "actor",
        "executionContext",
        "startedAt",
        "endedAt",
        "effectsReconciliation",
        "result",
        "budgetPosition",
        "justification",
        "terminalDisposition"
      ],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "executionContext": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "commandSequence": {
              "type": "string",
              "minLength": 1
            },
            "plan": {
              "type": "string",
              "minLength": 1
            },
            "workflow": {
              "type": "string",
              "minLength": 1
            },
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "agent": {
              "type": "string",
              "minLength": 1
            },
            "strategy": {
              "type": "string",
              "minLength": 1
            },
            "task": {
              "type": "string",
              "minLength": 1
            },
            "session": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "endedAt": {
          "type": "string",
          "format": "date-time"
        },
        "effectsReconciliation": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "Successful",
            "Failed",
            "Indeterminate"
          ],
          "description": "Failed or Indeterminate execution, including read-only execution for the same objective or blocker, consumes retry budget. Successful evidence-only discovery, reconciliation, and validation may be non-consuming."
        },
        "budgetPosition": {
          "enum": [
            "initial-attempt",
            "retry-1",
            "retry-2",
            "non-consuming"
          ]
        },
        "justification": {
          "type": "string",
          "minLength": 1
        },
        "terminalDisposition": {
          "enum": [
            "objective-completed",
            "retry-authorized",
            "reported-unresolved",
            "not-terminal"
          ]
        }
      }
    },
    "budgetedAttempt": {
      "allOf": [
        {
          "$ref": "#/$defs/ledgerAction"
        },
        {
          "if": {
            "properties": {
              "result": {
                "const": "Successful"
              }
            },
            "required": [
              "result"
            ]
          },
          "then": {
            "properties": {
              "terminalDisposition": {
                "const": "objective-completed"
              }
            }
          },
          "else": {
            "properties": {
              "terminalDisposition": {
                "enum": [
                  "retry-authorized",
                  "reported-unresolved"
                ]
              }
            }
          }
        }
      ]
    },
    "resetAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priorSequenceStopReport",
        "authorizedBy",
        "authorizationEvidence",
        "materialChange"
      ],
      "properties": {
        "priorSequenceStopReport": {
          "type": "string",
          "minLength": 1
        },
        "authorizedBy": {
          "type": "string",
          "minLength": 1
        },
        "authorizationEvidence": {
          "type": "string",
          "minLength": 1
        },
        "materialChange": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "retrySequence": {
      "type": "object",
      "description": "One execution sequence. It contains a budgeted initial attempt (and any retries), one or more successful non-consuming evidence actions, or both; an evidence-only sequence does not fabricate a budgeted attempt.",
      "additionalProperties": false,
      "required": [
        "sequenceId",
        "nonConsumingActions"
      ],
      "properties": {
        "sequenceId": {
          "type": "string",
          "minLength": 1
        },
        "resetAuthorization": {
          "$ref": "#/$defs/resetAuthorization"
        },
        "attempts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initialAttempt"
          ],
          "properties": {
            "initialAttempt": {
              "allOf": [
                {
                  "$ref": "#/$defs/budgetedAttempt"
                },
                {
                  "properties": {
                    "budgetPosition": {
                      "const": "initial-attempt"
                    }
                  }
                }
              ]
            },
            "retry1": {
              "allOf": [
                {
                  "$ref": "#/$defs/budgetedAttempt"
                },
                {
                  "properties": {
                    "budgetPosition": {
                      "const": "retry-1"
                    }
                  }
                }
              ]
            },
            "retry2": {
              "allOf": [
                {
                  "$ref": "#/$defs/budgetedAttempt"
                },
                {
                  "properties": {
                    "budgetPosition": {
                      "const": "retry-2"
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "result": {
                        "enum": [
                          "Failed",
                          "Indeterminate"
                        ]
                      }
                    },
                    "required": [
                      "result"
                    ]
                  },
                  "then": {
                    "properties": {
                      "terminalDisposition": {
                        "const": "reported-unresolved"
                      }
                    }
                  }
                }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "retry1"
                ]
              },
              "then": {
                "required": [
                  "initialAttempt"
                ],
                "properties": {
                  "initialAttempt": {
                    "properties": {
                      "result": {
                        "enum": [
                          "Failed",
                          "Indeterminate"
                        ]
                      },
                      "terminalDisposition": {
                        "const": "retry-authorized"
                      }
                    },
                    "required": [
                      "result"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "required": [
                  "retry2"
                ]
              },
              "then": {
                "required": [
                  "initialAttempt",
                  "retry1"
                ],
                "properties": {
                  "retry1": {
                    "properties": {
                      "result": {
                        "enum": [
                          "Failed",
                          "Indeterminate"
                        ]
                      },
                      "terminalDisposition": {
                        "const": "retry-authorized"
                      }
                    },
                    "required": [
                      "result"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "initialAttempt": {
                    "properties": {
                      "terminalDisposition": {
                        "const": "retry-authorized"
                      }
                    },
                    "required": [
                      "terminalDisposition"
                    ]
                  }
                },
                "required": [
                  "initialAttempt"
                ]
              },
              "then": {
                "required": [
                  "retry1"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "retry1": {
                    "properties": {
                      "terminalDisposition": {
                        "const": "retry-authorized"
                      }
                    },
                    "required": [
                      "terminalDisposition"
                    ]
                  }
                },
                "required": [
                  "retry1"
                ]
              },
              "then": {
                "required": [
                  "retry2"
                ]
              }
            }
          ]
        },
        "nonConsumingActions": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/ledgerAction"
              },
              {
                "properties": {
                  "budgetPosition": {
                    "const": "non-consuming"
                  },
                  "result": {
                    "const": "Successful"
                  },
                  "terminalDisposition": {
                    "const": "not-terminal"
                  }
                }
              }
            ]
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "attempts"
          ]
        },
        {
          "properties": {
            "nonConsumingActions": {
              "minItems": 1
            }
          },
          "required": [
            "nonConsumingActions"
          ]
        }
      ]
    },
    "retrySequenceWithFailure": {
      "allOf": [
        {
          "$ref": "#/$defs/retrySequence"
        },
        {
          "properties": {
            "attempts": {
              "anyOf": [
                {
                  "properties": {
                    "initialAttempt": {
                      "properties": {
                        "result": {
                          "enum": [
                            "Failed",
                            "Indeterminate"
                          ]
                        }
                      },
                      "required": [
                        "result"
                      ]
                    }
                  },
                  "required": [
                    "initialAttempt"
                  ]
                },
                {
                  "properties": {
                    "retry1": {
                      "properties": {
                        "result": {
                          "enum": [
                            "Failed",
                            "Indeterminate"
                          ]
                        }
                      },
                      "required": [
                        "result"
                      ]
                    }
                  },
                  "required": [
                    "retry1"
                  ]
                },
                {
                  "properties": {
                    "retry2": {
                      "properties": {
                        "result": {
                          "enum": [
                            "Failed",
                            "Indeterminate"
                          ]
                        }
                      },
                      "required": [
                        "result"
                      ]
                    }
                  },
                  "required": [
                    "retry2"
                  ]
                }
              ]
            }
          },
          "required": [
            "attempts"
          ]
        }
      ]
    },
    "initialRetrySequence": {
      "allOf": [
        {
          "$ref": "#/$defs/retrySequence"
        },
        {
          "not": {
            "required": [
              "resetAuthorization"
            ]
          }
        }
      ]
    },
    "resetRetrySequence": {
      "allOf": [
        {
          "$ref": "#/$defs/retrySequence"
        },
        {
          "required": [
            "resetAuthorization"
          ]
        }
      ]
    },
    "unresolvedRetrySequence": {
      "allOf": [
        {
          "$ref": "#/$defs/retrySequence"
        },
        {
          "required": [
            "attempts"
          ],
          "properties": {
            "attempts": {
              "anyOf": [
                {
                  "required": [
                    "retry2"
                  ],
                  "properties": {
                    "retry2": {
                      "properties": {
                        "result": {
                          "enum": [
                            "Failed",
                            "Indeterminate"
                          ]
                        },
                        "terminalDisposition": {
                          "const": "reported-unresolved"
                        }
                      },
                      "required": [
                        "result",
                        "terminalDisposition"
                      ]
                    }
                  }
                },
                {
                  "not": {
                    "required": [
                      "retry2"
                    ]
                  },
                  "required": [
                    "retry1"
                  ],
                  "properties": {
                    "retry1": {
                      "properties": {
                        "result": {
                          "enum": [
                            "Failed",
                            "Indeterminate"
                          ]
                        },
                        "terminalDisposition": {
                          "const": "reported-unresolved"
                        }
                      },
                      "required": [
                        "result",
                        "terminalDisposition"
                      ]
                    }
                  }
                },
                {
                  "not": {
                    "required": [
                      "retry1"
                    ]
                  },
                  "properties": {
                    "initialAttempt": {
                      "properties": {
                        "result": {
                          "enum": [
                            "Failed",
                            "Indeterminate"
                          ]
                        },
                        "terminalDisposition": {
                          "const": "reported-unresolved"
                        }
                      },
                      "required": [
                        "result",
                        "terminalDisposition"
                      ]
                    }
                  },
                  "required": [
                    "initialAttempt"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "initialUnresolvedRetrySequence": {
      "allOf": [
        {
          "$ref": "#/$defs/initialRetrySequence"
        },
        {
          "$ref": "#/$defs/unresolvedRetrySequence"
        }
      ]
    },
    "resetUnresolvedRetrySequence": {
      "allOf": [
        {
          "$ref": "#/$defs/resetRetrySequence"
        },
        {
          "$ref": "#/$defs/unresolvedRetrySequence"
        }
      ]
    },
    "objectiveRetryLedger": {
      "type": "object",
      "description": "Preserves zero or more prior sequences that ended reported-unresolved and exactly one current sequence. A current sequence after any prior sequence requires reset authorization.",
      "additionalProperties": false,
      "required": [
        "priorUnresolvedSequences",
        "currentSequence"
      ],
      "properties": {
        "priorUnresolvedSequences": {
          "type": "array",
          "description": "Preserved earlier sequences in chronological order; every item must end Failed or Indeterminate with reported-unresolved.",
          "prefixItems": [
            {
              "$ref": "#/$defs/initialUnresolvedRetrySequence"
            }
          ],
          "items": {
            "$ref": "#/$defs/resetUnresolvedRetrySequence"
          }
        },
        "currentSequence": {
          "description": "The latest sequence for the objective. It is the initial sequence when no prior unresolved sequence exists and otherwise must carry reset authorization.",
          "$ref": "#/$defs/retrySequence"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "priorUnresolvedSequences": {
                "maxItems": 0
              }
            },
            "required": [
              "priorUnresolvedSequences"
            ]
          },
          "then": {
            "properties": {
              "currentSequence": {
                "$ref": "#/$defs/initialRetrySequence"
              }
            }
          },
          "else": {
            "properties": {
              "currentSequence": {
                "$ref": "#/$defs/resetRetrySequence"
              }
            }
          }
        }
      ]
    },
    "objectiveRetryLedgerWithFailure": {
      "allOf": [
        {
          "$ref": "#/$defs/objectiveRetryLedger"
        },
        {
          "anyOf": [
            {
              "properties": {
                "priorUnresolvedSequences": {
                  "minItems": 1
                }
              },
              "required": [
                "priorUnresolvedSequences"
              ]
            },
            {
              "properties": {
                "currentSequence": {
                  "$ref": "#/$defs/retrySequenceWithFailure"
                }
              },
              "required": [
                "currentSequence"
              ]
            }
          ]
        }
      ]
    }
  },
  "x-schemaVersion": "2.0.0"
}
