    "objectiveRetryLedgerCore": {
      "type": "object",
      "description": "One objective's outcome summaries and retry evidence. Preserves zero or more prior sequences that ended reported-unresolved and exactly one current sequence.",
      "additionalProperties": false,
      "required": [
