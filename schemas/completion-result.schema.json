{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AIAllTheThingz/Public-AI-Governance/main/schemas/completion-result.schema.json",
  "title": "Completion Result",
  "description": "Records implementation state, validation outcomes, limitations, risk, compatibility impact, review, and execution discipline without treating a single successful command as proof of full completion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "filesChanged",
    "validation",
    "limitations",
    "schemaVersion",
    "executionDiscipline"
  ],
  "properties": {
    "status": {
      "enum": [
        "implemented",
        "validated",
        "partially-validated",
        "not-completed"
      ],
      "description": "Overall completion state."
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "filesChanged": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "risk": {
      "enum": [
        "low",
        "moderate",
        "high",
        "critical"
      ]
    },
    "securityImpact": {
      "type": "string",
      "minLength": 1
    },
    "compatibilityImpact": {
      "type": "string",
      "minLength": 1
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "result"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "passed",
              "failed",
              "not-run"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "environment": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time"
    },
    "artifact": {
      "type": "string",
      "minLength": 1,
      "description": "Commit, tag, digest, or artifact identifier to which the result applies."
    },
    "schemaVersion": {
      "type": "string",
      "const": "2.0.0",
      "description": "Required explicit instance contract version."
    },
    "executionDiscipline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorizationRecoveryContinuity",
        "retryLedger",
        "resetBasis",
        "progressOrBlockerNarrowing",
        "outOfScopeRouting"
      ],
      "properties": {
        "authorizationRecoveryContinuity": {
          "type": "string",
          "minLength": 1
        },
        "retryLedger": {
          "type": "object",
          "description": "The single authoritative map of per-objective retry evidence. Each objective ledger carries its own failed or indeterminate outcome summaries, preventing one objective from being split across independent maps.",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "patternProperties": {
            "^.+$": {
              "$ref": "#/$defs/objectiveRetryLedger"
            }
          },
          "additionalProperties": false
        },
        "resetBasis": {
          "type": "string",
          "minLength": 1,
          "description": "Summary of any retry-budget reset. Each sequence after the first records its own prior stop/report, authorization, material-change evidence, and causal rationale. Not applicable is permitted when no reset occurred."
        },
        "progressOrBlockerNarrowing": {
          "type": "string",
          "minLength": 1
        },
        "outOfScopeRouting": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced extension data. Extension keys must be organization- or product-specific and must not redefine standard fields.",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{1,127}$"
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "validated"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "validation": {
            "contains": {
              "properties": {
                "result": {
                  "const": "passed"
                }
              },
              "required": [
                "result"
              ]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "validation": {
            "contains": {
              "properties": {
                "result": {
                  "const": "passed"
                }
              },
              "required": [
                "result"
              ]
            }
          }
        },
        "required": [
          "validation"
        ]
      },
      "then": {
        "properties": {
          "executionDiscipline": {
            "properties": {
              "retryLedger": {
                "minProperties": 1,
                "not": {
                  "patternProperties": {
                    "^.+$": {
                      "not": {
                        "$ref": "#/$defs/objectiveRetryLedgerWithSuccess"
                      }
                    }
                  }
                }
              }
            },
            "required": [
              "retryLedger"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "validation": {
            "contains": {
              "properties": {
                "result": {
                  "const": "failed"
                }
              },
              "required": [
                "result"
              ]
            }
          }
        },
        "required": [
          "validation"
        ]
      },
      "then": {
        "properties": {
          "executionDiscipline": {
            "properties": {
              "retryLedger": {
                "minProperties": 1,
                "not": {
                  "patternProperties": {
                    "^.+$": {
                      "not": {
                        "$ref": "#/$defs/objectiveRetryLedgerWithFailure"
                      }
                    }
                  }
                }
              }
            },
            "required": [
              "retryLedger"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "ledgerAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "actor",
        "executionContext",
        "startedAt",
        "endedAt",
        "effectsReconciliation",
        "result",
        "budgetPosition",
        "justification",
        "terminalDisposition"
      ],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "executionContext": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "commandSequence": {
              "type": "string",
              "minLength": 1
            },
            "plan": {
              "type": "string",
              "minLength": 1
            },
            "workflow": {
              "type": "string",
              "minLength": 1
            },
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "agent": {
              "type": "string",
              "minLength": 1
            },
            "strategy": {
              "type": "string",
              "minLength": 1
            },
            "task": {
              "type": "string",
              "minLength": 1
            },
            "session": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "endedAt": {
          "type": "string",
          "format": "date-time"
        },
        "effectsReconciliation": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "Successful",
            "Failed",
            "Indeterminate"
          ],
          "description": "Failed or Indeterminate execution, including read-only execution for the same objective or blocker, consumes retry budget. Successful evidence-only discovery, reconciliation, and validation may be non-consuming."
        },
        "budgetPosition": {
          "enum": [
            "initial-attempt",
            "retry-1",
            "retry-2",
            "non-consuming"
          ]
        },
        "justification": {
          "type": "string",
          "minLength": 1
        },
        "materialChange": {
          "type": "string",
          "minLength": 1,
          "description": "Causally relevant new evidence, changed input, configuration, state, corrected assumption, or materially different implementation or validation method supporting a retry."
        },
        "causalRationale": {
          "type": "string",
          "minLength": 1,
          "description": "Why the recorded material change creates a concrete reason the retry may succeed."
        },
        "terminalDisposition": {
          "enum": [
            "objective-completed",
            "retry-authorized",
            "reported-unresolved",
            "not-terminal"
          ]
        }
      }
    },
    "budgetedAttempt": {
      "allOf": [
        {
          "$ref": "#/$defs/ledgerAction"
        },
        {
          "if": {
            "properties": {
              "result": {
                "const": "Successful"
              }
            },
            "required": [
              "result"
            ]
          },
          "then": {
            "properties": {
              "terminalDisposition": {
                "const": "objective-completed"
              }
            }
          },
          "else": {
            "properties": {
              "terminalDisposition": {
                "enum": [
                  "retry-authorized",
                  "reported-unresolved"
                ]
              }
            }
          }
        }
      ]
    },
    "retryAttempt": {
      "allOf": [
        {
          "$ref": "#/$defs/budgetedAttempt"
        },
        {
          "required": [
            "materialChange",
            "causalRationale"
          ]
        }
      ]
    },
    "resetAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priorSequenceStopReport",
        "authorizedBy",
        "authorizationEvidence",
        "materialChange",
        "causalRationale"
      ],
      "properties": {
        "priorSequenceStopReport": {
          "type": "string",
          "minLength": 1
        },
        "authorizedBy": {
          "type": "string",
          "minLength": 1
        },
        "authorizationEvidence": {
          "type": "string",
          "minLength": 1
        },
        "materialChange": {
          "type": "string",
          "minLength": 1
        },
        "causalRationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "delegationHandoff": {
      "type": "object",
      "description": "Per-sequence delegation state. Failure evidence is the containing objective ledger's failedOrIndeterminateOutcomes array, and retryCount must equal this sequence's recorded retry depth.",
      "additionalProperties": false,
      "required": [
        "delegated",
        "summary",
        "boundariesPreserved"
      ],
      "properties": {
        "delegated": {
          "type": "boolean"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "meaningfulValue": {
          "type": "string",
          "minLength": 1
        },
        "blocker": {
          "type": "string",
          "minLength": 1
        },
        "retryCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "unresolvedState": {
          "const": "unresolved"
        },
        "boundariesPreserved": {
          "const": true,
          "description": "Delegation must preserve retry-budget, no-progress, scope, authorization, and evidence boundaries."
        }
      },
      "if": {
        "properties": {
          "delegated": {
            "const": true
          }
        },
        "required": [
          "delegated"
        ]
      },
      "then": {
        "required": [
          "meaningfulValue",
          "blocker",
          "retryCount",
          "unresolvedState"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "meaningfulValue"
              ]
            },
            {
              "required": [
                "blocker"
              ]
            },
            {
              "required": [
                "retryCount"
              ]
            },
            {
              "required": [
                "unresolvedState"
              ]
            }
          ]
        }
      }
    },
    "nonConsumingAction": {
      "allOf": [
        {
          "$ref": "#/$defs/ledgerAction"
        },
        {
          "properties": {
            "budgetPosition": {
              "const": "non-consuming"
            },
            "result": {
              "const": "Successful"
            },
            "terminalDisposition": {
              "const": "not-terminal"
            }
          }
        }
      ]
    },
    "retrySequence": {
      "type": "object",
      "description": "One execution sequence. It contains a budgeted initial attempt (and any retries), one or more successful non-consuming evidence actions, or both; an evidence-only sequence does not fabricate a budgeted attempt.",
      "additionalProperties": false,
      "required": [
        "sequenceId",
        "delegationHandoff",
        "preTerminalNonConsumingActions",
        "nonConsumingActions"
      ],
      "properties": {
        "sequenceId": {
          "type": "string",
          "minLength": 1
        },
        "resetAuthorization": {
          "$ref": "#/$defs/resetAuthorization"
        },
        "delegationHandoff": {
          "$ref": "#/$defs/delegationHandoff"
        },
        "attempts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initialAttempt"
          ],
          "properties": {
            "initialAttempt": {
              "allOf": [
                {
                  "$ref": "#/$defs/budgetedAttempt"
                },
                {
                  "properties": {
                    "budgetPosition": {
                      "const": "initial-attempt"
                    }
                  }
                }
              ]
            },
            "retry1": {
              "allOf": [
                {
                  "$ref": "#/$defs/retryAttempt"
                },
                {
                  "properties": {
                    "budgetPosition": {
                      "const": "retry-1"
                    }
                  }
                }
              ]
            },
            "retry2": {
              "allOf": [
                {
                  "$ref": "#/$defs/retryAttempt"
                },
                {
                  "properties": {
                    "budgetPosition": {
                      "const": "retry-2"
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "result": {
                        "enum": [
                          "Failed",
                          "Indeterminate"
                        ]
                      }
                    },
                    "required": [
                      "result"
                    ]
                  },
                  "then": {
                    "properties": {
                      "terminalDisposition": {
                        "const": "reported-unresolved"
                      }
                    }
                  }
                }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "retry1"
                ]
              },
              "then": {
                "required": [
                  "initialAttempt"
                ],
                "properties": {
                  "initialAttempt": {
                    "properties": {
                      "result": {
                        "enum": [
                          "Failed",
                          "Indeterminate"
                        ]
                      },
                      "terminalDisposition": {
                        "const": "retry-authorized"
                      }
                    },
                    "required": [
                      "result"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "required": [
                  "retry2"
                ]
              },
              "then": {
                "required": [
                  "initialAttempt",
                  "retry1"
                ],
                "properties": {
                  "retry1": {
                    "properties": {
                      "result": {
                        "enum": [
                          "Failed",
                          "Indeterminate"
                        ]
                      },
                      "terminalDisposition": {
                        "const": "retry-authorized"
                      }
                    },
                    "required": [
                      "result"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "initialAttempt": {
                    "properties": {
                      "terminalDisposition": {
                        "const": "retry-authorized"
                      }
                    },
                    "required": [
                      "terminalDisposition"
                    ]
                  }
                },
                "required": [
                  "initialAttempt"
                ]
              },
              "then": {
                "required": [
                  "retry1"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "retry1": {
                    "properties": {
                      "terminalDisposition": {
                        "const": "retry-authorized"
                      }
                    },
                    "required": [
                      "terminalDisposition"
                    ]
                  }
                },
                "required": [
                  "retry1"
                ]
              },
              "then": {
                "required": [
                  "retry2"
                ]
              }
            }
          ]
        },
        "preTerminalNonConsumingActions": {
          "type": "array",
          "description": "Successful evidence actions performed before this sequence's terminal reported-unresolved attempt. This array is empty for sequences that do not end reported-unresolved.",
          "items": {
            "$ref": "#/$defs/nonConsumingAction"
          }
        },
        "nonConsumingActions": {
          "type": "array",
          "description": "Successful evidence actions in a sequence that has not ended reported-unresolved. This array must be empty when the sequence reports unresolved.",
          "items": {
            "$ref": "#/$defs/nonConsumingAction"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "attempts": {
                "required": [
                  "retry2"
                ]
              }
            },
            "required": [
              "attempts"
            ]
          },
          "then": {
            "properties": {
              "delegationHandoff": {
                "properties": {
                  "retryCount": {
                    "const": 2
                  }
                }
              }
            }
          },
          "else": {
            "if": {
              "properties": {
                "attempts": {
                  "required": [
                    "retry1"
                  ]
                }
              },
              "required": [
                "attempts"
              ]
            },
            "then": {
              "properties": {
                "delegationHandoff": {
                  "properties": {
                    "retryCount": {
                      "const": 1
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "delegationHandoff": {
                  "properties": {
                    "retryCount": {
                      "const": 0
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "delegationHandoff": {
                "properties": {
                  "delegated": {
                    "const": true
                  }
                },
                "required": [
                  "delegated"
                ]
              }
            },
            "required": [
              "delegationHandoff"
            ]
          },
          "then": {
            "$ref": "#/$defs/reportedUnresolvedAttempts"
          }
        },
        {
          "if": {
            "$ref": "#/$defs/reportedUnresolvedAttempts"
          },
          "then": {
            "properties": {
              "nonConsumingActions": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "preTerminalNonConsumingActions": {
                "maxItems": 0
              }
            }
          }
        }
      ],
      "anyOf": [
        {
          "required": [
            "attempts"
          ]
        },
        {
          "properties": {
            "nonConsumingActions": {
              "minItems": 1
            }
          },
          "required": [
            "nonConsumingActions"
          ]
        }
      ]
    },
    "retrySequenceWithSuccess": {
      "allOf": [
        {
          "$ref": "#/$defs/retrySequence"
        },
        {
          "anyOf": [
            {
              "properties": {
                "attempts": {
                  "anyOf": [
                    {
                      "properties": {
                        "initialAttempt": {
                          "properties": {
                            "result": {
                              "const": "Successful"
                            }
                          },
                          "required": [
                            "result"
                          ]
                        }
                      },
                      "required": [
                        "initialAttempt"
                      ]
                    },
                    {
                      "properties": {
                        "retry1": {
                          "properties": {
                            "result": {
                              "const": "Successful"
                            }
                          },
                          "required": [
                            "result"
                          ]
                        }
                      },
                      "required": [
                        "retry1"
                      ]
                    },
                    {
                      "properties": {
                        "retry2": {
                          "properties": {
                            "result": {
                              "const": "Successful"
                            }
                          },
                          "required": [
                            "result"
                          ]
                        }
                      },
                      "required": [
                        "retry2"
                      ]
                    }
                  ]
                }
              },
              "required": [
                "attempts"
              ]
            },
            {
              "properties": {
                "nonConsumingActions": {
                  "contains": {
                    "properties": {
                      "result": {
                        "const": "Successful"
                      }
                    },
                    "required": [
                      "result"
                    ]
                  },
                  "minContains": 1
                }
              },
              "required": [
                "nonConsumingActions"
              ]
            },
            {
              "properties": {
                "preTerminalNonConsumingActions": {
                  "contains": {
                    "properties": {
                      "result": {
                        "const": "Successful"
                      }
                    },
                    "required": [
                      "result"
                    ]
                  },
                  "minContains": 1
                }
              },
              "required": [
                "preTerminalNonConsumingActions"
              ]
            }
          ]
        }
      ]
    },
    "retrySequenceWithFailure": {
      "allOf": [
        {
          "$ref": "#/$defs/retrySequence"
        },
        {
          "properties": {
            "attempts": {
              "anyOf": [
                {
                  "properties": {
                    "initialAttempt": {
                      "properties": {
                        "result": {
                          "enum": [
                            "Failed",
                            "Indeterminate"
                          ]
                        }
                      },
                      "required": [
                        "result"
                      ]
                    }
                  },
                  "required": [
                    "initialAttempt"
                  ]
                },
                {
                  "properties": {
                    "retry1": {
                      "properties": {
                        "result": {
                          "enum": [
                            "Failed",
                            "Indeterminate"
                          ]
                        }
                      },
                      "required": [
                        "result"
                      ]
                    }
                  },
                  "required": [
                    "retry1"
                  ]
                },
                {
                  "properties": {
                    "retry2": {
                      "properties": {
                        "result": {
                          "enum": [
                            "Failed",
                            "Indeterminate"
                          ]
                        }
                      },
                      "required": [
                        "result"
                      ]
                    }
                  },
                  "required": [
                    "retry2"
                  ]
                }
              ]
            }
          },
          "required": [
            "attempts"
          ]
        }
      ]
    },
    "initialRetrySequence": {
      "allOf": [
        {
          "$ref": "#/$defs/retrySequence"
        },
        {
          "not": {
            "required": [
              "resetAuthorization"
            ]
          }
        }
      ]
    },
    "resetRetrySequence": {
      "allOf": [
        {
          "$ref": "#/$defs/retrySequence"
        },
        {
          "required": [
            "resetAuthorization"
          ]
        }
      ]
    },
    "reportedUnresolvedAttempts": {
      "required": [
        "attempts"
      ],
      "properties": {
        "attempts": {
          "anyOf": [
            {
              "required": [
                "retry2"
              ],
              "properties": {
                "retry2": {
                  "properties": {
                    "result": {
                      "enum": [
                        "Failed",
                        "Indeterminate"
                      ]
                    },
